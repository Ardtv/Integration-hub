# Hub
HUB_PORT=3001
HUB_API_TOKEN=your-token-here

# amo-connector
AMO_WEBHOOK_PORT=3002
HUB_URL=http://localhost:3001
AMO_WEBHOOK_SECRET=your-webhook-secret-here

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=instinct_db
DB_USER=instinct_user
DB_PASSWORD=your-db-password-here

# Logging
LOG_LEVEL=info
NODE_ENV=development

# amoCRM API (для дозапроса)
AMO_API_DOMAIN=instinkt.amocrm.ru
AMO_API_TOKEN=your-long-lived-token


# IIKO (v2 auth: apiKey + appId + clientSecret)
IIKO_API_BASE=https://api-ru.iiko.services
IIKO_API_KEY=your-api-key-from-iikoweb
IIKO_APP_ID=your-app-uuid
IIKO_CLIENT_SECRET=your-client-secret
