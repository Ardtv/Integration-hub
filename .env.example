# ───────── Режим ─────────
NODE_ENV=production
# test: во внешние системы ничего не записывается, запросы видны в панели контроля.
# live включается только двумя строками сразу: HUB_MODE=live и HUB_LIVE_CONFIRM=yes
HUB_MODE=test
HUB_LIVE_CONFIRM=

# ───────── Хаб ─────────
HUB_PORT=3001
HUB_API_TOKEN=
HUB_URL=http://127.0.0.1:3001
LOG_LEVEL=info

# ───────── База хаба (отдельная от мини-аппы) ─────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=instinct_db
DB_USER=
DB_PASSWORD=

# ───────── amoCRM ─────────
AMO_API_DOMAIN=
AMO_API_TOKEN=
AMO_WEBHOOK_PORT=3002
AMO_WEBHOOK_SECRET=
# ID берутся из scripts/amo-discover.js или scripts/amo-setup.js
AMO_PIPELINE_IDS=
AMO_STAGE_SEND=
AMO_STAGE_CREATED=
AMO_STAGE_DELIVERED=
AMO_STAGE_ERROR=
AMO_STAGE_RETURN=
AMO_FIELD_METHOD=
AMO_FIELD_COUNTRY=
AMO_FIELD_DELIVERY_TYPE=
AMO_FIELD_CITY=
AMO_FIELD_ADDRESS=
AMO_FIELD_PVZ=
AMO_FIELD_TRACK=
# true: бюджет сделки должен равняться сумме товаров, иначе заявка не создаётся
AMO_STRICT_SUM=true

# ───────── СДЭК ─────────
# Боевой контур: https://api.cdek.ru/v2   Тестовый: https://api.edu.cdek.ru/v2
CDEK_API_BASE=https://api.edu.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_WEBHOOK_PORT=3003
CDEK_WEBHOOK_SECRET=
CDEK_TARIFF_DOOR=
CDEK_TARIFF_PVZ=
# Откуда уходит заказ: код пункта отгрузки ЛИБО адрес в JSON
CDEK_SHIPMENT_POINT=
CDEK_FROM_LOCATION_JSON=
CDEK_DEFAULT_ITEM_WEIGHT_G=200
CDEK_BOX_LENGTH_CM=20
CDEK_BOX_WIDTH_CM=15
CDEK_BOX_HEIGHT_CM=10
# Дополнительные поля заказа (JSON). Сюда идут параметры заявки на фулфилмент.
CDEK_ORDER_EXTRA_JSON=
CDEK_ORDER_EXTRA_KZ_JSON=
CDEK_ORDER_EXTRA_RU_JSON=
# Какие статусы СДЭК считать отгрузкой, доставкой и возвратом
CDEK_SHIPPED_CODES=RECEIVED_AT_SHIPMENT_WAREHOUSE,READY_FOR_SHIPMENT_IN_SENDER_CITY,TAKEN_BY_TRANSPORTER_FROM_SENDER_CITY
CDEK_DELIVERED_CODES=DELIVERED
CDEK_RETURNED_CODES=NOT_DELIVERED

# ───────── Фулфилмент СДЭК (Orderadmin): остатки ─────────
FF_API_BASE=https://cdek.api.orderadmin.ru
FF_DOMAIN=cdek
FF_USERNAME=
FF_PASSWORD=
FF_CURRENCY=KZT

# ───────── IIKO ─────────
IIKO_API_BASE=https://api-ru.iiko.services
IIKO_API_KEY=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_ORGANIZATION_ID=
IIKO_EXTERNAL_MENU_ID=
# Списание по отгрузке
IIKO_WRITEOFF_ENABLED=false
IIKO_STORE_ID=
IIKO_EXPENSE_ACCOUNT_ID=
IIKO_DEFAULT_UNIT_ID=

# ───────── 1С (OData) ─────────
API_1C_ENABLED=false
API_1C_BASE=
API_1C_USER=
API_1C_PASSWORD=
API_1C_SALE_DOCUMENT=Document_РеализацияТоваровУслуг
API_1C_RETURN_DOCUMENT=Document_ВозвратТоваровОтКлиента
API_1C_ITEMS_TABLE=Товары
API_1C_COUNTERPARTY_CATALOG=Catalog_Контрагенты
API_1C_COUNTERPARTY_KZ=Розница
API_1C_COUNTERPARTY_RU=Розница РФ
API_1C_COUNTERPARTY_KZ_REF=
API_1C_COUNTERPARTY_RU_REF=
API_1C_DOCUMENT_EXTRA_JSON=

# ───────── Алерты и резервные копии ─────────
ALERT_TG_BOT_TOKEN=
ALERT_TG_CHAT_ID=
BACKUP_DIR=/var/backups/integration-hub
BACKUP_KEEP_DAYS=14
# rclone-remote:путь или user@host:путь — копия за пределами сервера
BACKUP_REMOTE=
